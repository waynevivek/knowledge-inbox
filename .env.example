# Pooled Neon Postgres connection string (used at runtime)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) Neon Postgres connection string (used by Prisma CLI migrations)
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Separate Postgres connection string for integration tests (must not equal DATABASE_URL)
TEST_DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb_test?sslmode=require"

# Better Auth configuration (generate secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-random-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth App credentials (callback URL: <BETTER_AUTH_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID="replace-with-github-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-oauth-client-secret"

# Comma-separated list of emails allowed to sign up / sign in
ALLOWED_EMAILS="you@example.com"


